{
  "name": "gemma-discord-bot-unified",
  "version": "1.0.0",
  "description": "Unified Google Gemma Discord Bot (Frontend, CF Worker Backend, and Discord Slash Commands)",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev",
